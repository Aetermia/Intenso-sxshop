# Copiá este archivo a ".env.local" SOLO si necesitás cambiar algo.
# Con el sitio y la carpeta backend/ en el mismo dominio no hace falta nada.

# Dirección de la API PHP. Por defecto es "/backend/api" (mismo dominio).
# Cambiala si backend/ queda en otra carpeta o en otro dominio, y volvé a
# compilar (npm run build) para que tome el valor:
# VITE_API_URL=https://intensotandil.com.ar/backend/api

# Solo para "npm run dev": a dónde reenviar los pedidos a /backend.
# Por defecto http://localhost:8000 (levantalo con: php -S localhost:8000).
# VITE_DEV_BACKEND=http://localhost:8000
